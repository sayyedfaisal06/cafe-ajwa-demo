{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/bulk-order", "destination": "/catering", "statusCode": 301 },
    { "source": "/social", "destination": "/links", "statusCode": 301 },
    { "source": "/combo", "destination": "/menu/c/combos", "statusCode": 302 },
    { "source": "/account/wallet", "destination": "/account/loyalty", "statusCode": 301 },
    { "source": "/orders", "destination": "/account/orders", "statusCode": 301 },
    {
      "source": "/menu",
      "has": [{ "type": "query", "key": "category", "value": "(?<slug>[a-z-]+)" }],
      "destination": "/menu/c/:slug",
      "statusCode": 301
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/__spa-fallback.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
